{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "styleContinuity", "shots", "warnings"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "styleContinuity": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "startTime",
          "endTime",
          "title",
          "visualDescription",
          "narrative",
          "shotSize",
          "cameraAngle",
          "cameraMovement",
          "lensAndDepth",
          "lighting",
          "music",
          "sound",
          "transition",
          "imagePromptChinese",
          "imagePromptEnglish",
          "videoPromptChinese",
          "videoPromptEnglish",
          "continuityLock",
          "exclusions"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "startTime": { "type": "number", "minimum": 0 },
          "endTime": { "type": "number", "minimum": 0 },
          "title": { "type": "string", "minLength": 1 },
          "visualDescription": { "type": "string", "minLength": 1 },
          "narrative": { "type": "string", "minLength": 1 },
          "shotSize": { "type": "string", "minLength": 1 },
          "cameraAngle": { "type": "string", "minLength": 1 },
          "cameraMovement": { "type": "string", "minLength": 1 },
          "lensAndDepth": { "type": "string", "minLength": 1 },
          "lighting": { "type": "string", "minLength": 1 },
          "music": { "type": "string", "minLength": 1 },
          "sound": { "type": "string", "minLength": 1 },
          "transition": { "type": "string", "minLength": 1 },
          "imagePromptChinese": { "type": "string", "minLength": 1 },
          "imagePromptEnglish": { "type": "string", "minLength": 1 },
          "videoPromptChinese": { "type": "string", "minLength": 1 },
          "videoPromptEnglish": { "type": "string", "minLength": 1 },
          "continuityLock": { "type": "string", "minLength": 1 },
          "exclusions": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
