{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["variants", "warnings"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "decisionGuide", "platformPrompts"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["faithful", "balanced", "creative"]
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "decisionGuide": {
            "type": "object",
            "additionalProperties": false,
            "required": ["visualStrategy", "bestFor", "tradeoff"],
            "properties": {
              "visualStrategy": { "type": "string" },
              "bestFor": { "type": "string" },
              "tradeoff": { "type": "string" }
            }
          },
          "platformPrompts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["midjourney", "gptImage2"],
            "properties": {
              "midjourney": {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "promptChinese", "promptEnglish", "referenceUsage", "parameters", "negativeGuidance"],
                "properties": {
                  "prompt": { "type": "string" },
                  "promptChinese": { "type": "string" },
                  "promptEnglish": { "type": "string" },
                  "referenceUsage": { "type": "string" },
                  "parameters": { "type": "string" },
                  "negativeGuidance": { "type": "string" }
                }
              },
              "gptImage2": {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "promptChinese", "promptEnglish", "imageRoles", "editBoundary", "negativeGuidance"],
                "properties": {
                  "prompt": { "type": "string" },
                  "promptChinese": { "type": "string" },
                  "promptEnglish": { "type": "string" },
                  "imageRoles": { "type": "string" },
                  "editBoundary": { "type": "string" },
                  "negativeGuidance": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    }
  }
}
